{
  "buildCommand": "cd trinetra-ai && npm install && npm run build",
  "outputDirectory": "trinetra-ai/dist",
  "framework": "vite",
  "routes": [
    {
      "src": "/sentinel/(.*)",
      "dest": "/api/sentinel/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
